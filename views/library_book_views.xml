<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista de Libros -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.tree</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <tree string="Books" sample="1">
                <field name="cover_image_128" widget="image" class="avatar me-2" options="{'size': [40, 40]}" optional="show"/>
                <field name="name" string="Title"/>
                <field name="isbn"/>
                <field name="author_id"/>
                <field name="publication_year" options="{'format': false}"/>
                <field name="pages" optional="hide"/>
                <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'borrowed'"
                       decoration-danger="state == 'lost'"/>
            </tree>
        </field>
    </record>

    <!-- Vista Kanban: catalogo en cuadricula (sin agrupar por estado).
         El estado se ve dentro de cada tarjeta y se filtra con el panel lateral. -->
    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="author_id"/>
                <field name="state"/>
                <field name="cover_image_128"/>
                <field name="publication_year"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2 shadow-sm rounded border">
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle o-no-caret btn btn-sm btn-link text-muted" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                                    <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                </div>
                            </div>

                            <div class="d-flex align-items-start">
                                <!-- Portada del Libro (miniatura de 128 px) -->
                                <div class="me-3 flex-shrink-0">
                                    <t t-if="record.cover_image_128.raw_value">
                                        <img t-att-src="kanban_image('library.book', 'cover_image_128', record.id.raw_value)"
                                             alt="Cover" class="rounded border" style="width: 65px; height: 95px; object-fit: cover;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 65px; height: 95px;">
                                            <i class="fa fa-book fa-2x"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Detalles del Libro -->
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <strong class="o_kanban_record_title fs-6 text-primary d-block text-truncate">
                                        <field name="name"/>
                                    </strong>

                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-user me-1" title="Author"/> <field name="author_id"/>
                                    </div>

                                    <div t-if="record.publication_year.raw_value" class="text-muted small">
                                        <i class="fa fa-calendar me-1" title="Year"/> <field name="publication_year" options="{'format': false}"/>
                                    </div>

                                    <div class="mt-2">
                                        <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>

                                    <!-- Estado: al no haber columnas, se muestra en la tarjeta -->
                                    <div class="mt-2">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'available': 'success', 'borrowed': 'warning', 'lost': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Formulario de Libros -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_mark_lost" string="Mark as Lost" type="object"
                            class="btn-outline-danger"
                            invisible="state not in ('available', 'borrowed')"
                            groups="library_manager.group_library_manager"/>
                    <button name="action_recover" string="Recover" type="object"
                            class="btn-outline-success"
                            invisible="state != 'lost'"
                            groups="library_manager.group_library_manager"/>
                    <button name="action_suggest_categories" string="Suggest Categories (AI)"
                            type="object" class="btn-outline-primary" icon="fa-magic"
                            groups="library_manager.group_library_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,borrowed,lost"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                    </div>

                    <!-- Portada en el Formulario (imagen grande) -->
                    <field name="cover_image" widget="image" class="oe_avatar" options="{'size': [110, 160]}"/>

                    <div class="oe_title">
                        <label for="name" string="Book Title"/>
                        <h1><field name="name" placeholder="e.g. Don Quijote de la Mancha"/></h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="author_id" options="{'no_create_edit': True}"/>
                            <field name="isbn" placeholder="e.g. 978-3-16-148410-0"/>
                            <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                        <group string="Publication Details">
                            <field name="publication_year" options="{'format': false}"/>
                            <field name="pages"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" icon="fa-file-text-o">
                            <field name="description" placeholder="Write a brief description or summary of the book..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Búsqueda (con panel lateral de filtros) -->
    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Books">
                <field name="name" string="Title or ISBN"
                       filter_domain="['|', ('name', 'ilike', self), ('isbn', 'ilike', self)]"/>
                <field name="author_id"/>
                <field name="category_ids"/>
                <separator/>
                <filter name="filter_available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_borrowed" string="Borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter name="filter_lost" string="Lost" domain="[('state', '=', 'lost')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
                <!-- Panel lateral: aparece a la izquierda en lista y kanban, con contadores -->
                <searchpanel>
                    <field name="state" string="Status" icon="fa-flag" enable_counters="1"/>
                    <field name="category_ids" select="multi" string="Categories" icon="fa-tags" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Acción de Libros -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
    </record>

</odoo>