<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Se carga al final del manifest: todas las acciones ya existen.
         Los menus que cuelgan directamente de la raiz salen como pestañas
         en la barra superior. Se abre el de sequence mas bajo (Home). -->
    <menuitem id="menu_library_root"
              name="Library"
              groups="library_manager.group_library_user"
              sequence="10"/>

    <menuitem id="menu_library_home"
              name="Home"
              parent="menu_library_root"
              action="action_library_dashboard"
              sequence="1"/>

    <menuitem id="menu_library_book"
              name="Books"
              parent="menu_library_root"
              action="action_library_book"
              sequence="10"/>

    <menuitem id="menu_library_author"
              name="Authors"
              parent="menu_library_root"
              action="action_library_author"
              sequence="20"/>

    <menuitem id="menu_library_member"
              name="Members"
              parent="menu_library_root"
              action="action_library_member"
              sequence="30"/>

    <menuitem id="menu_library_loan"
              name="Loans"
              parent="menu_library_root"
              action="action_library_loan"
              sequence="40"/>

    <!-- ===== Estadisticas ===== -->
    <menuitem id="menu_library_reports"
              name="Statistics"
              parent="menu_library_root"
              sequence="50"/>

    <menuitem id="menu_library_reports_popularity"
              name="Popularity"
              parent="menu_library_reports"
              sequence="10"/>
    <menuitem id="menu_library_report_top_books"
              name="Most Borrowed Books"
              parent="menu_library_reports_popularity"
              action="action_library_report_top_books"
              sequence="10"/>
    <menuitem id="menu_library_report_least_books"
              name="Least Borrowed Books"
              parent="menu_library_reports_popularity"
              action="action_library_report_least_books"
              sequence="20"/>
    <menuitem id="menu_library_report_top_authors"
              name="Most Read Authors"
              parent="menu_library_reports_popularity"
              action="action_library_report_top_authors"
              sequence="30"/>
    <menuitem id="menu_library_report_top_readers"
              name="Most Active Readers"
              parent="menu_library_reports_popularity"
              action="action_library_report_top_readers"
              sequence="40"/>

    <menuitem id="menu_library_reports_activity"
              name="Activity"
              parent="menu_library_reports"
              sequence="20"/>
    <menuitem id="menu_library_report_months"
              name="Loans per Month"
              parent="menu_library_reports_activity"
              action="action_library_report_months"
              sequence="10"/>
    <menuitem id="menu_library_report_status"
              name="Loans by Status"
              parent="menu_library_reports_activity"
              action="action_library_report_status"
              sequence="20"/>
    <menuitem id="menu_library_report_analysis"
              name="Loan Analysis"
              parent="menu_library_reports_activity"
              action="action_library_report_analysis"
              sequence="30"/>

    <!-- Desplegable para datos maestros que se tocan poco -->
    <menuitem id="menu_library_config"
              name="Configuration"
              parent="menu_library_root"
              sequence="90"/>

    <menuitem id="menu_library_category"
              name="Categories"
              parent="menu_library_config"
              action="action_library_category"
              sequence="10"/>
</odoo>
