<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista de autores -->
    <record id="view_library_author_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <tree string="Authors" sample="1" class="o_library_list">
                <header>
                    <button name="action_queue_openlibrary_refresh"
                            string="Queue Open Library Refresh" type="object"
                            display="always" class="btn-primary"
                            icon="fa-refresh"
                            groups="library_manager.group_library_manager"/>
                </header>
                <field name="photo_128" widget="image" class="avatar me-2"
                       options="{'size': [40, 40]}" optional="show"/>
                <field name="name"/>
                <field name="openlibrary_key" widget="library_na_char"/>
                <field name="birth_date" widget="library_na_date"/>
                <field name="death_date" widget="library_na_date" optional="show"/>
                <field name="book_count"/>
                <field name="total_pages"/>
            </tree>
        </field>
    </record>

    <!-- Vista kanban de autores con fotografía -->
    <record id="view_library_author_kanban" model="ir.ui.view">
        <field name="name">library.author.kanban</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column o_library_author_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="photo_128"/>
                <field name="openlibrary_key"/>
                <field name="birth_date"/>
                <field name="death_date"/>
                <field name="book_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2 shadow-sm rounded border o_library_author_card">
                            <div class="o_dropdown_kanban dropdown">
                                <a role="button" class="dropdown-toggle o-no-caret btn btn-sm btn-link text-muted" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                                    <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="me-3 flex-shrink-0">
                                    <t t-if="record.photo_128.raw_value">
                                        <img t-att-src="kanban_image('library.author', 'photo_128', record.id.raw_value)"
                                             alt="Author photo" class="rounded-circle border"
                                             style="width: 72px; height: 72px; object-fit: cover;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center text-muted"
                                             style="width: 72px; height: 72px;">
                                            <i class="fa fa-user fa-2x" title="Author"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <strong class="o_kanban_record_title fs-6 text-primary d-block text-truncate">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-calendar me-1" title="Birth Date"/>
                                        <t t-if="record.birth_date.raw_value"><field name="birth_date"/></t>
                                        <t t-else="">NA</t>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fa fa-calendar-times-o me-1" title="Death Date"/>
                                        <t t-if="record.death_date.raw_value"><field name="death_date"/></t>
                                        <t t-else="">NA</t>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-book me-1" title="Books"/>
                                        <field name="book_count"/> books
                                    </div>
                                    <div class="text-muted small text-truncate">
                                        <i class="fa fa-hashtag me-1" title="Open Library ID"/>
                                        <t t-if="record.openlibrary_key.raw_value"><field name="openlibrary_key"/></t>
                                        <t t-else="">NA</t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista de formulario de autores -->
    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author" class="o_library_form">
            <header>
                <button name="action_fill_from_openlibrary"
                        string="Autofill from Open Library" type="object"
                        class="btn-outline-primary" icon="fa-download"
                        groups="library_manager.group_library_manager"/>
                <button name="action_print_report" string="Print PDF" type="object"
                        class="btn-primary" icon="fa-print"/>
            </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"
                           options="{'size': [110, 110]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_author_books" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Author Name"/>
                        <h1><field name="name" placeholder="e.g. Miguel de Cervantes"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="birth_date" widget="library_na_date" placeholder="NA"/>
                            <field name="death_date" widget="library_na_date" placeholder="NA"/>
                            <field name="openlibrary_key" widget="library_na_char" placeholder="NA"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biography">
                            <field name="bio" widget="library_na_text" placeholder="Write a brief biography..."/>
                        </page>
                        <page string="Other Names and Links">
                            <group>
                                <field name="alternate_names" widget="library_na_text" placeholder="One alternate name per line"/>
                                <field name="external_links" widget="library_na_text" placeholder="External references from Open Library"/>
                            </group>
                        </page>
                        <page string="Books">
                            <field name="book_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Acción y Menús de Autores -->
    <record id="action_library_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Vista de busqueda de autores -->
    <record id="view_library_author_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search string="Authors">
                <field name="name"/>
                <field name="bio"/>
                <field name="alternate_names"/>
                <field name="openlibrary_key"/>
                <!-- Panel lateral: filtro por letra inicial, con contadores -->
                <searchpanel>
                    <field name="name_initial" string="Initial" icon="fa-sort-alpha-asc" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>