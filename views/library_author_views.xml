<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista lista de autores -->
    <record id="view_library_author_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <tree string="Authors">
                <header>
                    <button name="action_queue_openlibrary_refresh"
                            string="Queue Open Library Refresh" type="object"
                            display="always" class="btn-primary"
                            icon="fa-refresh"
                            groups="library_manager.group_library_manager"/>
                </header>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="book_count"/>
                <field name="total_pages"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario de autores -->
    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
            <header>
                <button name="action_fill_from_openlibrary"
                        string="Autofill from Open Library" type="object"
                        class="btn-outline-primary" icon="fa-download"
                        groups="library_manager.group_library_manager"/>
                <button name="action_print_report" string="Print PDF" type="object"
                        class="btn-primary" icon="fa-print"/>
            </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_author_books" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="birth_date"/>
                            <field name="openlibrary_key"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biography">
                            <field name="bio" placeholder="Write a brief biography..."/>
                        </page>
                        <page string="Books">
                            <field name="book_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción y Menús de Autores -->
    <record id="action_library_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Vista de busqueda de autores -->
    <record id="view_library_author_search" model="ir.ui.view">
        <field name="name">library.author.search</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <search string="Authors">
                <field name="name"/>
                <field name="bio"/>
            </search>
        </field>
    </record>
</odoo>
