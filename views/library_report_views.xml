<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================== GRAFICOS ====================== -->

    <!-- 1) Prestamos por mes (linea) -->
    <record id="view_library_loan_report_graph_months" model="ir.ui.view">
        <field name="name">library.loan.report.graph.months</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <graph string="Loans per Month" type="line" sample="1" disable_linking="1">
                <field name="loan_date" interval="month" type="row"/>
                <field name="loan_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 2) Libros mas prestados: una linea por libro (top 10) a lo largo de los meses -->
    <record id="view_library_loan_report_graph_top_books" model="ir.ui.view">
        <field name="name">library.loan.report.graph.top.books</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <graph string="Loans per Month by Book" type="line" sample="1" disable_linking="1">
                <field name="loan_date" interval="month" type="row"/>
                <field name="book_id" type="row"/>
                <field name="loan_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 3) Autores mas leidos: una linea por autor -->
    <record id="view_library_loan_report_graph_top_authors" model="ir.ui.view">
        <field name="name">library.loan.report.graph.top.authors</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <graph string="Loans per Month by Author" type="line" sample="1" disable_linking="1">
                <field name="loan_date" interval="month" type="row"/>
                <field name="author_id" type="row"/>
                <field name="loan_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 4) Lectores mas activos: una linea por socio -->
    <record id="view_library_loan_report_graph_top_readers" model="ir.ui.view">
        <field name="name">library.loan.report.graph.top.readers</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <graph string="Loans per Month by Member" type="line" sample="1" disable_linking="1">
                <field name="loan_date" interval="month" type="row"/>
                <field name="member_id" type="row"/>
                <field name="loan_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 5) Prestamos por estado (tarta) -->
    <record id="view_library_loan_report_graph_status" model="ir.ui.view">
        <field name="name">library.loan.report.graph.status</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <graph string="Loans by Status" type="pie" sample="1" disable_linking="1">
                <field name="loan_state" type="row"/>
                <field name="loan_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ======================= PIVOT ======================== -->

    <!-- Analisis general: libros en filas, meses en columnas -->
    <record id="view_library_loan_report_pivot" model="ir.ui.view">
        <field name="name">library.loan.report.pivot</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <pivot string="Loan Analysis" sample="1" disable_linking="1">
                <field name="book_id" type="row"/>
                <field name="loan_date" interval="month" type="col"/>
                <field name="loan_count" type="measure"/>
                <field name="days_late" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Libros menos prestados (0 = nunca prestado) -->
    <record id="view_library_loan_report_pivot_least" model="ir.ui.view">
        <field name="name">library.loan.report.pivot.least</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <pivot string="Least Borrowed Books" sample="1" disable_linking="1">
                <field name="book_id" type="row"/>
                <field name="loan_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ====================== BUSQUEDA ====================== -->
    <record id="view_library_loan_report_search" model="ir.ui.view">
        <field name="name">library.loan.report.search</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <search string="Loan Statistics">
                <field name="book_id"/>
                <field name="author_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('loan_state', '=', 'ongoing')]"/>
                <filter name="filter_returned" string="Returned" domain="[('loan_state', '=', 'returned')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('overdue_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'loan_date:month'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'loan_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Most Borrowed Books: filtros de cuantos elementos mostrar (se pueden cambiar desde la interfaz) -->
    <record id="view_library_loan_report_search_books" model="ir.ui.view">
        <field name="name">library.loan.report.search.books</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <search string="Most Borrowed Books">
                <field name="book_id"/>
                <field name="author_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="top_5" string="Top 5" domain="[('book_top_rank', '&lt;=', 5)]"/>
                <filter name="top_10" string="Top 10" domain="[('book_top_rank', '&lt;=', 10)]"/>
                <filter name="top_20" string="Top 20" domain="[('book_top_rank', '&lt;=', 20)]"/>
                <filter name="top_50" string="Top 50" domain="[('book_top_rank', '&lt;=', 50)]"/>
                <separator/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('loan_state', '=', 'ongoing')]"/>
                <filter name="filter_returned" string="Returned" domain="[('loan_state', '=', 'returned')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('overdue_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'loan_date:month'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'loan_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Most Read Authors: filtros de cuantos elementos mostrar (se pueden cambiar desde la interfaz) -->
    <record id="view_library_loan_report_search_authors" model="ir.ui.view">
        <field name="name">library.loan.report.search.authors</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <search string="Most Read Authors">
                <field name="book_id"/>
                <field name="author_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="top_5" string="Top 5" domain="[('author_rank', '&lt;=', 5)]"/>
                <filter name="top_10" string="Top 10" domain="[('author_rank', '&lt;=', 10)]"/>
                <filter name="top_20" string="Top 20" domain="[('author_rank', '&lt;=', 20)]"/>
                <filter name="top_50" string="Top 50" domain="[('author_rank', '&lt;=', 50)]"/>
                <separator/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('loan_state', '=', 'ongoing')]"/>
                <filter name="filter_returned" string="Returned" domain="[('loan_state', '=', 'returned')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('overdue_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'loan_date:month'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'loan_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Most Active Readers: filtros de cuantos elementos mostrar (se pueden cambiar desde la interfaz) -->
    <record id="view_library_loan_report_search_readers" model="ir.ui.view">
        <field name="name">library.loan.report.search.readers</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <search string="Most Active Readers">
                <field name="book_id"/>
                <field name="author_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="top_5" string="Top 5" domain="[('member_rank', '&lt;=', 5)]"/>
                <filter name="top_10" string="Top 10" domain="[('member_rank', '&lt;=', 10)]"/>
                <filter name="top_20" string="Top 20" domain="[('member_rank', '&lt;=', 20)]"/>
                <filter name="top_50" string="Top 50" domain="[('member_rank', '&lt;=', 50)]"/>
                <separator/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('loan_state', '=', 'ongoing')]"/>
                <filter name="filter_returned" string="Returned" domain="[('loan_state', '=', 'returned')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('overdue_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'loan_date:month'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'loan_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Least Borrowed Books: filtros de cuantos elementos mostrar (se pueden cambiar desde la interfaz) -->
    <record id="view_library_loan_report_search_least" model="ir.ui.view">
        <field name="name">library.loan.report.search.least</field>
        <field name="model">library.loan.report</field>
        <field name="arch" type="xml">
            <search string="Least Borrowed Books">
                <field name="book_id"/>
                <field name="author_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="bottom_5" string="Bottom 5" domain="[('book_low_rank', '&lt;=', 5)]"/>
                <filter name="bottom_10" string="Bottom 10" domain="[('book_low_rank', '&lt;=', 10)]"/>
                <filter name="bottom_20" string="Bottom 20" domain="[('book_low_rank', '&lt;=', 20)]"/>
                <filter name="bottom_50" string="Bottom 50" domain="[('book_low_rank', '&lt;=', 50)]"/>
                <separator/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('loan_state', '=', 'ongoing')]"/>
                <filter name="filter_returned" string="Returned" domain="[('loan_state', '=', 'returned')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('overdue_count', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                    <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
                    <filter name="group_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'loan_date:month'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'loan_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======================= ACCIONES ===================== -->

    <record id="action_library_report_months" model="ir.actions.act_window">
        <field name="name">Loans per Month</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search"/>
    </record>
    <record id="action_library_report_months_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_library_loan_report_graph_months"/>
        <field name="act_window_id" ref="action_library_report_months"/>
    </record>

    <record id="action_library_report_top_books" model="ir.actions.act_window">
        <field name="name">Most Borrowed Books</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search_books"/>
        <field name="context">{'search_default_top_10': 1}</field>
    </record>
    <record id="action_library_report_top_books_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_library_loan_report_graph_top_books"/>
        <field name="act_window_id" ref="action_library_report_top_books"/>
    </record>

    <record id="action_library_report_least_books" model="ir.actions.act_window">
        <field name="name">Least Borrowed Books</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">pivot</field>
        <field name="search_view_id" ref="view_library_loan_report_search_least"/>
        <field name="context">{'search_default_bottom_10': 1}</field>
    </record>
    <record id="action_library_report_least_books_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_library_loan_report_pivot_least"/>
        <field name="act_window_id" ref="action_library_report_least_books"/>
    </record>

    <record id="action_library_report_top_authors" model="ir.actions.act_window">
        <field name="name">Most Read Authors</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search_authors"/>
        <field name="context">{'search_default_top_10': 1}</field>
    </record>
    <record id="action_library_report_top_authors_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_library_loan_report_graph_top_authors"/>
        <field name="act_window_id" ref="action_library_report_top_authors"/>
    </record>

    <record id="action_library_report_top_readers" model="ir.actions.act_window">
        <field name="name">Most Active Readers</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search_readers"/>
        <field name="context">{'search_default_top_10': 1}</field>
    </record>
    <record id="action_library_report_top_readers_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_library_loan_report_graph_top_readers"/>
        <field name="act_window_id" ref="action_library_report_top_readers"/>
    </record>

    <record id="action_library_report_status" model="ir.actions.act_window">
        <field name="name">Loans by Status</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search"/>
    </record>
    <record id="action_library_report_status_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_library_loan_report_graph_status"/>
        <field name="act_window_id" ref="action_library_report_status"/>
    </record>

    <record id="action_library_report_analysis" model="ir.actions.act_window">
        <field name="name">Loan Analysis</field>
        <field name="res_model">library.loan.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="domain">[('loan_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_library_loan_report_search"/>
    </record>
</odoo>
