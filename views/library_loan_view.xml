<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Lista -->
    <record id="view_library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <tree string="Library Loans"
                  decoration-danger="state == 'ongoing' and days_overdue &gt; 0"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="book_id"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="days_overdue"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'ongoing'"
                       decoration-success="state == 'returned'"/>
            </tree>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Library Loan">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="library_manager.group_library_manager"/>
                    <button name="action_return" string="Return" type="object"
                            class="btn-primary"
                            invisible="state != 'ongoing'"
                            groups="library_manager.group_library_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'ongoing')"
                            groups="library_manager.group_library_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ongoing,returned"/>
                </header>
                <sheet>
                    <field name="member_state" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="member_state != 'suspended' or state != 'draft'">
                        This member is suspended and cannot borrow books.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'ongoing' or days_overdue == 0">
                        This loan is overdue.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="book_id" readonly="state != 'draft'"/>
                            <field name="member_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="loan_date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state in ('returned', 'cancelled')"/>
                            <field name="return_date"/>
                            <field name="days_overdue"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_library_loan_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search string="Search Loans">
                <field name="name"/>
                <field name="book_id"/>
                <field name="member_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active_loans" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="filter_overdue" string="Overdue"
                        domain="[('state', '=', 'ongoing'), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="returned_loans" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_member" string="Member" context="{'group_by': 'member_id'}"/>
                    <filter name="group_by_book" string="Book" context="{'group_by': 'book_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Library Loans</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_library_loan_search"/>
    </record>
</odoo>