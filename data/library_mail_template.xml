<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_library_loan_overdue" model="mail.template">
        <field name="name">Library: Overdue loan notice</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="subject">Overdue loan notice - {{ object.book_id.name }}</field>
        <field name="email_to">{{ object.member_id.email }}</field>
        <field name="lang">{{ object.member_id.lang }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.member_id.name or ''"/>,</p>
                <p>The return deadline for the following book has passed:</p>
                <ul>
                    <li><strong>Book:</strong> <t t-out="object.book_id.name"/></li>
                    <li><strong>Loan:</strong> <t t-out="object.name"/></li>
                    <li><strong>Due date:</strong> <t t-out="object.due_date"/></li>
                </ul>
                <p>Please return the book, or contact the library if you already did.</p>
                <p>Thank you,<br/>The Library</p>
            </div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
